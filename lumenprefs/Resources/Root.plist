<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Lumen</string>
			<key>footerText</key>
			<string>Живые обои для экрана блокировки и домашнего экрана. Изменения применяются сразу, без респринга.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Включить Lumen</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Обои</string>
			<key>footerText</key>
			<string>Для видео укажи путь к mp4 (H.264), например /var/mobile/Library/Lumen/video.mp4. Если файл не найден, будет градиент.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>Тип обоев</string>
			<key>key</key>
			<string>style</string>
			<key>default</key>
			<string>gradient</string>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>Градиент</string>
				<string>Видео</string>
			</array>
			<key>validValues</key>
			<array>
				<string>gradient</string>
				<string>video</string>
			</array>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>Видео</string>
			<key>key</key>
			<string>videoPath</string>
			<key>default</key>
			<string></string>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>placeholder</key>
			<string>/var/mobile/Library/Lumen/video.mp4</string>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Цвет</string>
			<key>footerText</key>
			<string>Цвет задаёт палитру градиента и кружочков. Для своего цвета выбери "Свой цвет" и впиши HEX, например #FF4DB8.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>Цветовая схема</string>
			<key>key</key>
			<string>colorTheme</string>
			<key>default</key>
			<string>lime</string>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>Лайм</string>
				<string>Мята</string>
				<string>Голубой</string>
				<string>Синий</string>
				<string>Фиолетовый</string>
				<string>Розовый</string>
				<string>Оранжевый</string>
				<string>Красный</string>
				<string>Свой цвет</string>
			</array>
			<key>validValues</key>
			<array>
				<string>lime</string>
				<string>mint</string>
				<string>cyan</string>
				<string>blue</string>
				<string>purple</string>
				<string>pink</string>
				<string>orange</string>
				<string>red</string>
				<string>custom</string>
			</array>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>HEX</string>
			<key>key</key>
			<string>customColor</string>
			<key>default</key>
			<string></string>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>placeholder</key>
			<string>#CCFF00</string>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Кружочки</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Плавающие кружочки</string>
			<key>key</key>
			<string>circles</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Количество</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>circleCount</string>
			<key>default</key>
			<real>10</real>
			<key>min</key>
			<real>3</real>
			<key>max</key>
			<real>24</real>
			<key>showValue</key>
			<true/>
			<key>isContinuous</key>
			<false/>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Скорость</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>circleSpeed</string>
			<key>default</key>
			<real>1</real>
			<key>min</key>
			<real>0.5</real>
			<key>max</key>
			<real>2.5</real>
			<key>showValue</key>
			<true/>
			<key>isContinuous</key>
			<false/>
			<key>defaults</key>
			<string>com.lime.lumen</string>
			<key>PostNotification</key>
			<string>com.lime.lumen/reload</string>
		</dict>
	</array>
	<key>title</key>
	<string>Lumen</string>
</dict>
</plist>
